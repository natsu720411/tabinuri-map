# Copy to .env.local, then set your real keys there. Never use a VITE_ prefix.
GEMINI_API_KEY=
# Optional. Leave empty to use the server default model.
GEMINI_MODEL=

# Used server-side for nearby shop / spot suggestions in Travel Mode.
# Keep this key private; do not expose it as VITE_GEOAPIFY_API_KEY.
GEOAPIFY_API_KEY=
